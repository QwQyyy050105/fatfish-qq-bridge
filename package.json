{
  "name": "fatfish-qq-bridge",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Portable QQ OneBot v11 companion with a local panel, compatible API backend and optional advanced DSH bridge",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs start",
    "init": "node src/main.mjs init",
    "doctor": "node --env-file-if-exists=.env src/main.mjs doctor",
    "demo": "node src/main.mjs demo",
    "start:advanced": "node --env-file-if-exists=.env src/bridge.js",
    "test": "node scripts/test-offline.mjs",
    "check:release": "node scripts/release_check.mjs",
    "setup:dsh": "node scripts/setup-dsh.mjs",
    "panel": "node --env-file-if-exists=.env src/main.mjs panel",
    "build:config": "node scripts/build-config-schema.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "json-bigint": "^1.0.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "js-yaml": "^4.3.2",
    "zod": "4.6.6"
  }
}
